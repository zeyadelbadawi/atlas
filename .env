# Atlas frontend — local development configuration.
#
# Same origin as production: the browser calls /api/v1 on the Vite dev
# server, whose /api proxy forwards to the API (vite.config.ts,
# BACKEND_PORT, default 3000). A cross-origin base URL
# (http://localhost:3000/api/v1) kept the HttpOnly session cookie from
# ever being stored, so every reload signed you out, and relative media
# URLs pointed at the dev server.
VITE_API_BASE_URL=/api/v1
