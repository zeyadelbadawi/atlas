          "config": {
            "title": {
              "en": "Another question?",
              "ar": "سؤال آخر؟"
            },
            "description": {
              "en": "Write to us and ask.",
              "ar": "راسلنا واطرح سؤالك."
            },
            "cta": {
              "label": {
                "en": "Write to us",
                "ar": "راسلنا"
              },
              "pageId": "fx-atelier-page-8"
            }
          }
        }
