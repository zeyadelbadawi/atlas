# Atlas frontend — production build-time configuration.
#
# Vite loads this automatically for `vite build --mode production` (the
# default mode for `vite build`). These are all build-time, public values
# baked into the client bundle by design (VITE_* vars are never secret) —
# safe to commit, unlike backend secrets.

# Phase 7 — relative path: the reverse proxy (Caddy) serves the API at
# /api/* on the exact same origin as the frontend, on the main domain,
# every academy subdomain, and any connected custom domain alike. No
# per-domain configuration and no cross-origin request needed.
VITE_API_BASE_URL=/api/v1

# Phase 7 — the real, live Atlas platform domain. Enables the
# subdomain/custom-domain public-website runtime (previously dormant with
# this unset, per env.config.ts's own doc comment).
VITE_PLATFORM_BASE_DOMAIN=atlass.dpdns.org

VITE_SITE_URL=https://atlass.dpdns.org
