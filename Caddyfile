# Security headers for the responses CADDY ITSELF serves — the SPA
# document and its assets.
#
# THEY ARE DELIBERATELY NOT APPLIED TO `/api/*`. Those responses come from
# the Nest app, which sets its own via helmet, and a site-wide `header`
# block added a SECOND copy on top of every proxied response. Verified in
# production: `/api/v1/auth/login` returned `x-content-type-options` and
# `x-frame-options` twice, and — worse — `referrer-policy` and
# `strict-transport-security` twice with DIFFERENT values
# (`strict-origin-when-cross-origin` vs `no-referrer`, one year vs 180
# days). Nothing was broken, because the specs pick a winner in each case
# (Referrer Policy takes the last valid value, RFC 6797 takes the first
# HSTS), but the effective policy was then an accident of ordering across
# two independently-configured layers rather than anything either of them
# intended. A duplicated `X-Frame-Options` is the one that could actually
# bite: browsers are entitled to treat a multi-valued XFO as invalid.
#
# So each layer now owns exactly what it serves: Caddy the documents,
# helmet the API. Neither header set was removed from anything.
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Powerful browser features are off unless a page of ours needs them:
		# camera/microphone/screen-share for live classes (the Zoom SDK runs
		# in our own page), fullscreen for our own player containers (the
		# forensic watermark must stay visible, so videos never go fullscreen
		# by themselves), YouTube embeds for autoplay/encrypted media.
		# Picture-in-picture is off everywhere: it would show a lesson video
		# without its watermark.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), autoplay=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), encrypted-media=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), picture-in-picture=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), idle-detection=(), xr-spatial-tracking=()"
	}
}

# Content-Security-Policy — ENFORCED (production-readiness pass; it ran
# Report-Only first, audit Decision 4).
#
# Enforced because the evidence supports it: the built SPA has no inline
# script, no eval/new Function and no third-party script host; a browser
# sweep of platform, dashboard and academy pages (EN/AR, desktop/mobile) and
# probes of every dynamic source (certificate PDF preview, builder srcdoc
# preview, hls.js worker, YouTube, direct-to-storage uploads) raised zero
# violations under this exact policy; production reported none. Browsers
# still report every violation to `/api/v1/security/csp-reports` (the
# backend normalises it — no URL query survives — logs it and counts it in
# `atlas_csp_violations_total{disposition="enforce"}`), so anything missed
# is visible at once. See docs/CSP_AND_TOKEN_STORAGE.md in the backend repo.
#
# `script-src 'self'` is the directive that matters: an injected script
# cannot run, so it cannot act as the signed-in user (the refresh token is
# an HttpOnly cookie and the access token lives only in page memory).
#
# What each source is for:
#   script-src 'self'            Vite's hashed bundles only; no inline script,
#                                no eval (JSON-LD blocks are data, not script)
#   style-src 'unsafe-inline'    Radix/sonner/recharts inject <style> and
#                                style attributes at runtime
#   font-src 'self' data:        fonts are self-hosted (src/styles/fonts.css);
#                                no third-party font origin
#   img-src/media-src https:     academy logos, course media and video
#                                segments come from each academy's own
#                                storage/CDN host, which is configuration
#   connect-src https:           direct-to-storage uploads and HLS segments,
#                                same reason
#   frame-src                    YouTube lessons (nocookie first), the website
#                                builder's same-origin preview, and `blob:` for
#                                the certificate template's PDF preview (an
#                                object URL of the server-rendered PDF)
#   worker-src blob:             hls.js
#   object-src 'none'            no plugins (Chromium's PDF viewer in a blob
#                                frame is unaffected — verified)
(csp) {
	header Reporting-Endpoints `csp-endpoint="/api/v1/security/csp-reports"`
	header Content-Security-Policy `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/v1/security/csp-reports; report-to csp-endpoint`
}

# DL-57 — the help center's CSP: static pages with one same-origin script,
# no inline style, no frame, no third-party anything. Stricter than the app
# (`csp`), which needs inline styles, YouTube frames and storage origins.
(docs_csp) {
	header Reporting-Endpoints `csp-endpoint="/api/v1/security/csp-reports"`
	header Content-Security-Policy `default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/v1/security/csp-reports; report-to csp-endpoint`
}

# Theme 1 plan §E.4 — theme photographs. Every file lives in a versioned
# folder (`/theme-assets/<theme>/v<n>/…`) that is never changed once
# released (a changed image ships as a new version), so browsers and
# Cloudflare may keep them for a year without revalidating. Same origin,
# so the CSP needs nothing new. A missing file is a real 404 — never the
# SPA's index.html served as an "image".
(theme_assets) {
	handle /theme-assets/* {
		import security_headers
		root * /srv
		# Only a file that exists is immutable; a 404 must stay uncached.
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# Stale-tab recovery — the app's own build output. A tab opened before a
# deploy asks for the chunks of the build it is running; the image keeps the
# previous builds' chunks for two weeks (Dockerfile), and a chunk that is
# truly gone is a real 404 — never the SPA's index.html served as
# JavaScript (which failed the module MIME check, and was cached by
# browsers for hours) — uncached, so the app's own recovery can act on it.
(app_assets) {
	handle /assets/* {
		import security_headers
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}
}

# Browser caching for the app's own static files (2 Oct 2026). Before this,
# nothing under /assets/ or the HTML shell carried a Cache-Control header,
# so every visit revalidated (or heuristically cached) everything.
#   * /assets/* — Vite's build output; every file name carries a content
#     hash, so a changed file is a new URL. Only a file that exists is
#     marked immutable; a 404 stays uncached.
#   * Everything else this block serves from disk is the SPA shell
#     (index.html via try_files) or a root file such as robots.txt — a
#     missing /assets/ file no longer reaches here (`app_assets` answers it
#     with a real 404): always revalidated, so a deploy is
#     picked up on the next request. `?` sets it only when the response has
#     none (the server renderer sets its own).
# API responses are routed elsewhere and never pass through here; nothing
# per-user or per-tenant is ever marked cacheable.
(static_cache) {
	@hashed_asset {
		path /assets/*
		file
	}
	header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
	# Everything else, including the shell served in place of a MISSING
	# /assets/ file (which must never be cached as if it were the chunk).
	@app_shell {
		not path /theme-assets/*
		not {
			path /assets/*
			file
		}
	}
	header @app_shell ?Cache-Control "no-cache"
}

# B0-WEB-08 — the service worker script must be revalidated on every
# load so a deploy (or the VITE_OFFLINE_SHELL=off kill switch) reaches
# browsers promptly. Set explicitly rather than relying on the
# `static_cache` fallback. NOTE: Cloudflare's zone Browser Cache TTL
# (default 4 h) overrides any origin max-age shorter than itself for files
# it caches, which is why the live header reads max-age=14400; the owner
# side of the fix is a Cloudflare Cache Rule for /sw.js (Browser TTL:
# respect origin). Browsers already bypass the HTTP cache for the worker's
# own update check (`updateViaCache` defaults to 'imports').
#
# B0-LRN-10 — certificate verification pages show a learner's name,
# course and dates: never indexed, on any host. Deferred so a server-
# rendered response cannot drop it; robots.txt deliberately does NOT
# disallow /verify/, or crawlers could not read this header.
(page_policy_headers) {
	header /sw.js Cache-Control "no-cache"
	@verify_page path /verify /verify/*
	header @verify_page {
		X-Robots-Tag "noindex, nofollow"
		defer
	}
}

# P63g — HSTS is split by ownership. Atlas owns the whole platform tree,
# so `includeSubDomains` is right there. A customer's custom domain is
# NOT Atlas's to make policy for: asserting `includeSubDomains` on
# `customer.com` would force-upgrade `mail.customer.com` and every other
# host under it for a year. The backend applies the same split on `/api/*`.
(hsts_platform) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
(hsts_custom_domain) {
	header Strict-Transport-Security "max-age=31536000"
}

# Phase 8 — server-rendered public Academy pages
# (Reports/SSR_ARCHITECTURE_ANALYSIS.md). A page request for an Academy host
# that matches no static file goes to the renderer (`ssr`, internal network
# only). The renderer answers with the rendered page, or with
# `X-Atlas-SSR: pass` for anything it does not render (sign-in, learner
# pages, unknown hosts, files) — Caddy then serves `/srv/index.html`, the
# exact single-page app it served before. A renderer 5xx, a timeout or a
# stopped container is answered the same way (`ssr_unavailable` below), so
# the website never depends on the renderer being up.
#
# Off unless the container's ATLAS_SSR is `on` (compose passes it from
# /opt/atlas/.env; the default is off): with it off, every request takes
# exactly the route it took before server rendering existed.
#
# The renderer receives the visitor's IP (the API's per-visitor rate
# limits) and the request as sent; it forwards no cookie or credential to
# the API and never renders a signed-in view. `/assets/*` reaches it only
# when this image lacks the file (a rollout where the renderer is a build
# ahead); it serves its own build's hashed chunks, else a real 404.
(ssr_proxy) {
	vars atlas_ssr 1
	reverse_proxy ssr:3100 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 1s
			response_header_timeout 3s
		}
		@pass header X-Atlas-SSR pass
		handle_response @pass {
			rewrite * /index.html
			file_server
		}
		@failed status 5xx
		handle_response @failed {
			rewrite * /index.html
			file_server
		}
	}
}

# The renderer could not be reached or timed out: the single-page app,
# with the headers the document always carries (`{args[0]}` is the site's
# HSTS snippet). Only for requests that went to the renderer — an API 502
# stays a 502, and a missing chunk is never answered with HTML.
(ssr_unavailable) {
	@ssr_unavailable {
		vars atlas_ssr 1
		not path /assets/*
		expression `{err.status_code} in [502, 503, 504]`
	}
	handle @ssr_unavailable {
		import security_headers
		import csp
		import {args[0]}
		root * /srv
		rewrite * /index.html
		file_server {
			status 200
		}
	}
}

# B0-OPS-04 — origin lock. Every legitimate request reaches this origin
# through Cloudflare: the platform and academy subdomains are proxied
# records, and connected custom domains arrive through Cloudflare for SaaS
# (certificates come from DNS-01, so nothing needs a direct HTTP-01 path).
# A connection whose socket peer is not a Cloudflare edge address is
# somebody who found the origin IP and is going around the WAF, the rate
# limits and the edge cache; it is dropped (no response bytes, no
# headers) before any route runs. `remote_ip` is the socket peer, never a
# forwarded header, so it cannot be spoofed by a client.
#
# `private_ranges` (loopback, RFC 1918, fd00::/8) keeps the in-container
# health check (`wget https://localhost/`), the deploy self-check and
# Docker's own proxy on the bridge gateway working; none of those is
# reachable from the internet.
#
# The ranges must equal `trusted_proxies` in the global options and the
# lists Cloudflare publishes (https://www.cloudflare.com/ips-v4, /ips-v6);
# `src/edge-origin-lock.test.ts` checks the first and the scheduled
# `cloudflare-ranges` workflow checks the second. A range Cloudflare adds
# and this list lacks would drop real visitors routed through it.
#
# Kill switch: ATLAS_ORIGIN_LOCK=off (compose passes it; unset or empty =
# on) serves direct connections again without a rebuild.
(origin_lock) {
	@direct_to_origin {
		expression `{env.ATLAS_ORIGIN_LOCK} != "off"`
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 private_ranges
	}
	abort @direct_to_origin
}

# Global options.
#
# fallback_sni (P63d): Cloudflare for SaaS connects to this origin for a
# customer's custom hostname with the CUSTOM hostname as the TLS SNI (the
# Host header too). This origin holds no certificate for a customer's
# name — and Caddy's catch-all block below cannot mint one, so before this
# option Caddy aborted the handshake ("no certificate available", TLS
# alert 80) and Cloudflare answered every visitor with 525 "SSL handshake
# failed". Verified in production against rawc.ae on 18 Sep 2026 and
# reproduced locally: with fallback_sni, an SNI that matches no loaded
# certificate is served the platform certificate instead, the handshake
# completes, and the request reaches the catch-all block where the Host
# header selects the academy. Cloudflare's origin SSL mode "Full" accepts a
# trusted certificate issued for a different name; "Full (strict)" would
# not (the Platform Owner readiness page reports the mode).
{
	fallback_sni atlass.dpdns.org

	# B0-OPS-04 — `abort` sorts after `redir` and `handle` by default, which
	# would let the origin lock run only after a route had answered. First
	# means it is evaluated before every other directive in every site.
	order abort first

	# B0-OPS-04 — Caddy's automatic HTTP->HTTPS redirect for the platform
	# names is a route of its own, inserted ahead of every site block, so it
	# answered direct connections to port 80 that the origin lock could not
	# see. The `:80` catch-all below performs the same redirect for every
	# host (platform names included) behind the lock.
	auto_https disable_redirects

	# P63g — Cloudflare's published edge ranges are the only proxies whose
	# forwarded headers are believed. With this, `{client_ip}` is the real
	# visitor (Cloudflare's CF-Connecting-IP / X-Forwarded-For are honoured
	# only from these ranges) and a request that reaches the origin directly
	# is attributed to its own socket peer. The backend keys every rate
	# limiter on the `X-Real-IP` we forward below, so without this every
	# visitor behind one Cloudflare datacentre shared one bucket.
	# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (18 Sep 2026).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Main platform + every academy subdomain: one wildcard certificate covers
# both, since both are served identically by this same container — the
# frontend build already branches "atlas-app" vs "academy-website" mode at
# the JS level based on hostname (resolvePublicWebsiteContext). The
# DNS-01 issuer is scoped to this site block specifically (not a global
# default) so it doesn't collide with the catch-all block's own `tls
# internal` policy below. CLOUDFLARE_API_TOKEN is provided at container
# start via env_file, never baked into the image.
atlass.dpdns.org, *.atlass.dpdns.org {
	import origin_lock

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	# B1 M0 (RDM L3–L8) — `www` is not a second copy of the platform: one
	# 301 to the apex, path and query kept (`{uri}`), on every path except
	# the API (RDM L7: unchanged until logs show no use). Matched before any
	# handler (`redir` sorts ahead of `handle`), so www never reaches the
	# marketing pages, root files or the app with its own host.
	@www_host {
		host www.atlass.dpdns.org
		not path /api/*
	}
	redir @www_host https://atlass.dpdns.org{uri} permanent

	# DL-63 — the platform app lives on dashboard.atlass.dpdns.org (its own
	# site block below). With ATLAS_DASHBOARD_REDIRECT=on every old app link
	# on the apex (sign-in, registration, email links, invites, certificate
	# QR codes) is sent there with ONE 301, path and query kept (`{uri}`);
	# the URL fragment stays with the browser. `/api/*` is never redirected:
	# unsubscribe POSTs, webhooks, email logos and the Google callback keep
	# working on the apex. Unset or `off` (the compose default until the
	# dashboard host is verified): the apex keeps serving the app as before.
	@app_moved {
		host atlass.dpdns.org
		expression `{env.ATLAS_DASHBOARD_REDIRECT} == "on"`
		path /auth /auth/* /dashboard /dashboard/* /onboarding /onboarding/* /academy-chooser /academy-chooser/* /verify /verify/* /403 /index.html
	}
	redir @app_moved https://dashboard.atlass.dpdns.org{uri} permanent

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			# ATO review F14 — the host the request actually reached, never a
			# client-supplied X-Forwarded-Host passed through a trusted proxy.
			header_up X-Forwarded-Host {host}
		}
	}

	# B0-WEB-01 — an academy subdomain answers /robots.txt and /sitemap.xml
	# with its OWN files, generated by the backend from its published
	# settings (indexing, sitemap) and pages. Without this the platform's
	# static robots.txt/sitemap.xml in /srv won every academy host. The
	# platform host itself keeps the static files.
	@academy_seo_files {
		not host atlass.dpdns.org www.atlass.dpdns.org
		path /robots.txt /sitemap.xml
	}
	handle @academy_seo_files {
		rewrite * /api/v1/public/websites/host{path}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Host {host}
		}
	}

	import theme_assets
	import app_assets

	handle {
		import security_headers
		import csp
		import hsts_platform
		root * /srv
		import static_cache
		import page_policy_headers
		# B1 / M1a (DL-50) — the static marketing site, platform apex ONLY.
		# Prerendered by `pnpm build` (scripts/marketing/prerender.mjs) and
		# kept in its own tree, /srv-marketing (Dockerfile), which no other
		# host's handler ever reads: academy subdomains and connected
		# domains cannot be served a marketing page or file. The same rules
		# run on `vite preview`/dev (src/marketing/prerender/routing.ts).
		#
		# ATLAS_MARKETING_STATIC (compose passes it; unset or empty = on):
		# `off` turns the pages off without a rebuild — `/`, `/pricing`… go
		# back to the single-page app (marked noindex below) — after one
		# `docker compose up -d --no-deps caddy`. The root files stay on.
		#
		# Order: root files → trailing-slash 301 → page → branded 404s →
		# (below) retired blog, academy renderer, the app.

		# Root files: /robots.txt, the sitemaps, llms.txt, llms-full.txt,
		# pricing.md and the OG images. A missing one is a real 404, never
		# the app shell. UTF-8 declared for the text formats.
		@marketing_root_file {
			host atlass.dpdns.org
			path /robots.txt /sitemap.xml /sitemaps/* /llms.txt /llms-full.txt /pricing.md /marketing-assets/*
		}
		handle @marketing_root_file {
			root * /srv-marketing
			header /pricing.md Content-Type "text/markdown; charset=utf-8"
			header /llms.txt Content-Type "text/plain; charset=utf-8"
			header /llms-full.txt Content-Type "text/plain; charset=utf-8"
			header /robots.txt Content-Type "text/plain; charset=utf-8"
			file_server
		}

		# DL-57 — the help center lives on docs.<base>; the planned apex paths
		# (`/docs/...`, `/ar/docs/...`) forward there, path kept.
		@docs_moved_ar {
			host atlass.dpdns.org
			path_regexp docs_ar ^/ar/docs(/.*)?$
		}
		redir @docs_moved_ar https://docs.atlass.dpdns.org/ar{re.docs_ar.1} permanent
		@docs_moved {
			host atlass.dpdns.org
			path_regexp docs ^/docs(/.*)?$
		}
		redir @docs_moved https://docs.atlass.dpdns.org{re.docs.1} permanent

		# One 301 from a page URL with a trailing slash to the URL without
		# it (`/ar/` → `/ar`, `/pricing/` → `/pricing`), query kept; only
		# when that page exists, so app routes are untouched.
		@marketing_slash {
			host atlass.dpdns.org
			method GET HEAD
			expression `{env.ATLAS_MARKETING_STATIC} != "off"`
			path */
			not path /
			file {
				root /srv-marketing
				try_files {path}index.html
			}
		}
		handle @marketing_slash {
			route {
				uri strip_suffix /
				redir * {path}{?query} permanent
			}
		}

		# A page: `/x` is /srv-marketing/x/index.html, `/` is index.html.
		# Only when that file exists — /dashboard, /auth/*, /index.html and
		# every other app path have none and fall through to the app.
		@marketing_page {
			host atlass.dpdns.org
			method GET HEAD
			expression `{env.ATLAS_MARKETING_STATIC} != "off"`
			file {
				root /srv-marketing
				try_files {path}/index.html
			}
		}
		handle @marketing_page {
			root * /srv-marketing
			rewrite * {file_match.relative}
			file_server
		}

		# Genuine 404s with the branded page (SPEC §B.1, §E.4, F-12): any
		# other `/ar/...` gets the Arabic one; the retired blog and the
		# planned feature pages (never a 200, a redirect or a soft 404) the
		# English one. Listed in src/marketing/prerender/routing.ts too.
		@marketing_gone_ar {
			host atlass.dpdns.org
			expression `{env.ATLAS_MARKETING_STATIC} != "off"`
			path /ar/*
			file {
				root /srv-marketing
				try_files /ar/404.html
			}
		}
		handle @marketing_gone_ar {
			root * /srv-marketing
			rewrite * /ar/404.html
			file_server {
				status 404
			}
		}
		@marketing_gone {
			host atlass.dpdns.org
			expression `{env.ATLAS_MARKETING_STATIC} != "off"`
			path /blog /blog/* /ar/blog /ar/blog/* /features/academy-website /features/payments /features/content-protection /features/teams-and-academies /features/quizzes-and-certificates /ar/features/academy-website /ar/features/payments /ar/features/content-protection /ar/features/teams-and-academies /ar/features/quizzes-and-certificates
			file {
				root /srv-marketing
				try_files /404.html
			}
		}
		handle @marketing_gone {
			root * /srv-marketing
			rewrite * /404.html
			file_server {
				status 404
			}
		}

		# With the static site switched off, the app answers the marketing
		# home and keeps it out of search results (the B0 holding state).
		@marketing_static_off {
			host atlass.dpdns.org
			expression `{env.ATLAS_MARKETING_STATIC} == "off"`
			path / /ar /ar/
		}
		header @marketing_static_off {
			X-Robots-Tag "noindex, follow"
			defer
		}

		# B0-WEB-13 — the legacy marketing site's blog is gone, and the SPA
		# answered `/blog` with a 200 "not found" page (a soft 404). On the
		# platform host it is a real 404: the branded page above while the
		# static site is on; otherwise the same shell (the app still shows
		# its own not-found page), with the status set, as
		# `ssr_unavailable` sets 200. Platform host only — an academy
		# website may have a page whose slug is `blog`.
		@retired_blog {
			host atlass.dpdns.org www.atlass.dpdns.org
			path /blog /blog/*
		}
		handle @retired_blog {
			rewrite * /index.html
			file_server {
				status 404
			}
		}
		# Academy subdomains only: the platform itself (apex, www) is the
		# dashboard and is never server-rendered.
		@academy_page {
			expression {env.ATLAS_SSR} == "on"
			not host atlass.dpdns.org www.atlass.dpdns.org
			method GET HEAD
			not file
		}
		handle @academy_page {
			import ssr_proxy
		}
		# DL-63 — once the app has moved, the apex no longer runs it: a
		# browser that installed the dashboard's service worker here gets a
		# worker that unregisters itself and clears its caches (it cannot
		# keep serving a stale app shell for the marketing site), and any
		# other path that is not a real file is the branded 404 — never the
		# app shell.
		@apex_retired_worker {
			host atlass.dpdns.org
			expression `{env.ATLAS_DASHBOARD_REDIRECT} == "on"`
			path /sw.js
		}
		handle @apex_retired_worker {
			header Cache-Control "no-cache"
			rewrite * /sw-retired.js
			file_server
		}
		@apex_no_app {
			host atlass.dpdns.org
			expression `{env.ATLAS_DASHBOARD_REDIRECT} == "on"`
			expression `{env.ATLAS_MARKETING_STATIC} != "off"`
			not file
		}
		handle @apex_no_app {
			root * /srv-marketing
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			# B1-4 — on the platform host everything that reaches the app
			# shell is the app itself (sign-in, registration, dashboards):
			# the marketing pages, root files and branded 404s were all
			# answered above. Keep it out of search results so only the
			# marketing site is indexed. Academy subdomains are untouched.
			@platform_app host atlass.dpdns.org www.atlass.dpdns.org
			header @platform_app X-Robots-Tag "noindex, follow"
			try_files {path} /index.html
			file_server
		}
	}

	handle_errors {
		import ssr_unavailable hsts_platform
	}
}

# DL-63 — the platform web app: sign-in, registration and every dashboard
# (Platform Owner, academy owner, manager, instructor). An exact name, so it
# wins over `*.atlass.dpdns.org`: the academy SEO files, the server renderer
# and the marketing pages never apply here. `dashboard` is reserved for
# academies in the API and the database (DL-58). Same app build, same API,
# same security headers as the apex; the whole host is kept out of search
# results. The session cookie is `__Host-` and bound to this host.
dashboard.atlass.dpdns.org {
	import origin_lock

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Host {host}
		}
	}

	import theme_assets
	import app_assets

	handle {
		import security_headers
		import csp
		import hsts_platform
		root * /srv
		import static_cache
		import page_policy_headers
		header X-Robots-Tag "noindex, nofollow"

		# Crawlers may fetch pages (so they read the noindex header); there is
		# nothing to list. The marketing site's own files are not served here.
		handle /robots.txt {
			header Content-Type "text/plain; charset=utf-8"
			respond <<ROBOTS
				User-agent: *
				Allow: /
				ROBOTS 200
		}
		handle /sitemap.xml /marketing-assets/* /sw-retired.js {
			respond 404
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}

# DL-57 — the Atlas Help Center: static pages prerendered by `pnpm build`
# (scripts/docs/prerender.mjs) into /srv-docs (Dockerfile), a tree no other
# host reads. These exact names win over `*.atlass.dpdns.org` (Caddy matches
# the most specific host first), so the academy wildcard, the server renderer
# and the app never see them; the names are reserved for academies in the
# API and the database (atlas-backend DL-57). `doc` and `help` are aliases.
#
# ATLAS_DOCS_STATIC (compose passes it; unset or empty = preview):
#   preview  pages are served with `X-Robots-Tag: noindex, nofollow` (live
#            review before search engines may index them)
#   on       indexable
#   off      every page answers 503 "not available" (noindex), no rebuild
#
# The only API reachable here is the cookieless beacon and CSP reports.
docs.atlass.dpdns.org, doc.atlass.dpdns.org, help.atlass.dpdns.org {
	import origin_lock

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	@docs_alias host doc.atlass.dpdns.org help.atlass.dpdns.org
	redir @docs_alias https://docs.atlass.dpdns.org{uri} permanent

	@docs_api path /api/v1/mkt/events /api/v1/security/csp-reports
	handle @docs_api {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Host {host}
		}
	}
	handle /api/* {
		respond 404
	}

	handle {
		import security_headers
		import docs_csp
		import hsts_platform
		root * /srv-docs

		@docs_off expression `{env.ATLAS_DOCS_STATIC} == "off"`
		handle @docs_off {
			header X-Robots-Tag "noindex, nofollow"
			header Cache-Control "no-store"
			respond "The Atlas Help Center is not available right now." 503
		}

		@docs_preview expression `{env.ATLAS_DOCS_STATIC} != "on"`
		header @docs_preview X-Robots-Tag "noindex, nofollow"

		# Hashed files (build assets, screenshots) never change; a missing
		# one is a real 404, uncached. Pages and indexes revalidate.
		@docs_immutable {
			path /assets/* /media/*
			file
		}
		header @docs_immutable Cache-Control "public, max-age=31536000, immutable"
		@docs_revalidate not path /assets/* /media/*
		header @docs_revalidate Cache-Control "no-cache"
		header /robots.txt Content-Type "text/plain; charset=utf-8"
		header /llms.txt Content-Type "text/plain; charset=utf-8"

		# `/x/` → `/x` (one 301, query kept) when that page exists.
		@docs_slash {
			method GET HEAD
			path */
			not path /
			file {
				try_files {path}index.html
			}
		}
		handle @docs_slash {
			route {
				uri strip_suffix /
				redir * {path}{?query} permanent
			}
		}

		# A page (`/selling/refunds` → selling/refunds/index.html) or a file.
		@docs_found {
			method GET HEAD
			file {
				try_files {path} {path}/index.html
			}
		}
		handle @docs_found {
			rewrite * {file_match.relative}
			file_server
		}

		# Anything else is a real 404 with the branded page in its language.
		handle /ar/* {
			rewrite * /ar/404.html
			file_server {
				status 404
			}
		}
		handle {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}

# P63g — custom hostnames arriving over plain HTTP (a customer's own
# proxy in a non-TLS origin mode, or a stray http:// link) are redirected
# to HTTPS instead of hitting an unhandled port. Since B0-OPS-04 the
# platform names use this block too (`auto_https disable_redirects`), so
# every port-80 request passes the origin lock first.
:80 {
	import origin_lock
	redir https://{host}{uri} permanent
}

# Catch-all fallback for connected custom domains (e.g. an academy's own
# domain via the existing Cloudflare Custom Hostnames flow). Cloudflare's
# edge terminates and manages TLS for the custom hostname itself once
# verified; this origin just needs to answer TLS on any other SNI and
# serve the same app — same static files, same API routing, Host header
# alone (already handled entirely by the frontend's own hostname-resolution
# logic) decides which academy is served. The certificate presented for
# that "any other SNI" comes from the global fallback_sni above — `tls
# internal` here only names the issuer for this block's (empty) hostname
# set and does NOT issue certificates for arbitrary SNI.
:443 {
	import origin_lock

	tls internal

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			# ATO review F14 — the host the request actually reached, never a
			# client-supplied X-Forwarded-Host passed through a trusted proxy.
			header_up X-Forwarded-Host {host}
		}
	}

	# B0-WEB-01 — every host here is an academy's connected domain: its own
	# robots.txt and sitemap.xml, never the platform's static files.
	@academy_seo_files {
		path /robots.txt /sitemap.xml
	}
	handle @academy_seo_files {
		rewrite * /api/v1/public/websites/host{path}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Host {host}
		}
	}

	import theme_assets
	import app_assets

	handle {
		# Previously this block set NO security headers at all, so an
		# academy serving its own connected domain got none of them on its
		# document while the same content on `*.atlass.dpdns.org` got all
		# four. Same app, same files, weaker headers — purely because of
		# which hostname the visitor arrived on.
		import security_headers
		import csp
		import hsts_custom_domain
		root * /srv
		import static_cache
		import page_policy_headers
		# Every host here is an Academy's connected domain.
		@academy_page {
			expression {env.ATLAS_SSR} == "on"
			method GET HEAD
			not file
		}
		handle @academy_page {
			import ssr_proxy
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	handle_errors {
		import ssr_unavailable hsts_custom_domain
	}
}
