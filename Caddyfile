# Security headers for the responses CADDY ITSELF serves — the SPA
# document and its assets.
#
# THEY ARE DELIBERATELY NOT APPLIED TO `/api/*`. Those responses come from
# the Nest app, which sets its own via helmet, and a site-wide `header`
# block added a SECOND copy on top of every proxied response. Verified in
# production: `/api/v1/auth/login` returned `x-content-type-options` and
# `x-frame-options` twice, and — worse — `referrer-policy` and
# `strict-transport-security` twice with DIFFERENT values
# (`strict-origin-when-cross-origin` vs `no-referrer`, one year vs 180
# days). Nothing was broken, because the specs pick a winner in each case
# (Referrer Policy takes the last valid value, RFC 6797 takes the first
# HSTS), but the effective policy was then an accident of ordering across
# two independently-configured layers rather than anything either of them
# intended. A duplicated `X-Frame-Options` is the one that could actually
# bite: browsers are entitled to treat a multi-valued XFO as invalid.
#
# So each layer now owns exactly what it serves: Caddy the documents,
# helmet the API. Neither header set was removed from anything.
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# P63g — HSTS is split by ownership. Atlas owns the whole platform tree,
# so `includeSubDomains` is right there. A customer's custom domain is
# NOT Atlas's to make policy for: asserting `includeSubDomains` on
# `customer.com` would force-upgrade `mail.customer.com` and every other
# host under it for a year. The backend applies the same split on `/api/*`.
(hsts_platform) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
(hsts_custom_domain) {
	header Strict-Transport-Security "max-age=31536000"
}

# Global options.
#
# fallback_sni (P63d): Cloudflare for SaaS connects to this origin for a
# customer's custom hostname with the CUSTOM hostname as the TLS SNI (the
# Host header too). This origin holds no certificate for a customer's
# name — and Caddy's catch-all block below cannot mint one, so before this
# option Caddy aborted the handshake ("no certificate available", TLS
# alert 80) and Cloudflare answered every visitor with 525 "SSL handshake
# failed". Verified in production against rawc.ae on 18 Sep 2026 and
# reproduced locally: with fallback_sni, an SNI that matches no loaded
# certificate is served the platform certificate instead, the handshake
# completes, and the request reaches the catch-all block where the Host
# header selects the academy. Cloudflare's origin SSL mode "Full" accepts a
# trusted certificate issued for a different name; "Full (strict)" would
# not (the Platform Owner readiness page reports the mode).
{
	fallback_sni atlass.dpdns.org

	# P63g — Cloudflare's published edge ranges are the only proxies whose
	# forwarded headers are believed. With this, `{client_ip}` is the real
	# visitor (Cloudflare's CF-Connecting-IP / X-Forwarded-For are honoured
	# only from these ranges) and a request that reaches the origin directly
	# is attributed to its own socket peer. The backend keys every rate
	# limiter on the `X-Real-IP` we forward below, so without this every
	# visitor behind one Cloudflare datacentre shared one bucket.
	# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (18 Sep 2026).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Main platform + every academy subdomain: one wildcard certificate covers
# both, since both are served identically by this same container — the
# frontend build already branches "atlas-app" vs "academy-website" mode at
# the JS level based on hostname (resolvePublicWebsiteContext). The
# DNS-01 issuer is scoped to this site block specifically (not a global
# default) so it doesn't collide with the catch-all block's own `tls
# internal` policy below. CLOUDFLARE_API_TOKEN is provided at container
# start via env_file, never baked into the image.
atlass.dpdns.org, *.atlass.dpdns.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		import security_headers
		import hsts_platform
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# P63g — custom hostnames arriving over plain HTTP (a customer's own
# proxy in a non-TLS origin mode, or a stray http:// link) are redirected
# to HTTPS instead of hitting an unhandled port. The platform names get
# this automatically from Caddy; the catch-all must declare it.
:80 {
	redir https://{host}{uri} permanent
}

# Catch-all fallback for connected custom domains (e.g. an academy's own
# domain via the existing Cloudflare Custom Hostnames flow). Cloudflare's
# edge terminates and manages TLS for the custom hostname itself once
# verified; this origin just needs to answer TLS on any other SNI and
# serve the same app — same static files, same API routing, Host header
# alone (already handled entirely by the frontend's own hostname-resolution
# logic) decides which academy is served. The certificate presented for
# that "any other SNI" comes from the global fallback_sni above — `tls
# internal` here only names the issuer for this block's (empty) hostname
# set and does NOT issue certificates for arbitrary SNI.
:443 {
	tls internal

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		# Previously this block set NO security headers at all, so an
		# academy serving its own connected domain got none of them on its
		# document while the same content on `*.atlass.dpdns.org` got all
		# four. Same app, same files, weaker headers — purely because of
		# which hostname the visitor arrived on.
		import security_headers
		import hsts_custom_domain
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
