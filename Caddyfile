# Security headers for the responses CADDY ITSELF serves — the SPA
# document and its assets.
#
# THEY ARE DELIBERATELY NOT APPLIED TO `/api/*`. Those responses come from
# the Nest app, which sets its own via helmet, and a site-wide `header`
# block added a SECOND copy on top of every proxied response. Verified in
# production: `/api/v1/auth/login` returned `x-content-type-options` and
# `x-frame-options` twice, and — worse — `referrer-policy` and
# `strict-transport-security` twice with DIFFERENT values
# (`strict-origin-when-cross-origin` vs `no-referrer`, one year vs 180
# days). Nothing was broken, because the specs pick a winner in each case
# (Referrer Policy takes the last valid value, RFC 6797 takes the first
# HSTS), but the effective policy was then an accident of ordering across
# two independently-configured layers rather than anything either of them
# intended. A duplicated `X-Frame-Options` is the one that could actually
# bite: browsers are entitled to treat a multi-valued XFO as invalid.
#
# So each layer now owns exactly what it serves: Caddy the documents,
# helmet the API. Neither header set was removed from anything.
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Content-Security-Policy — ENFORCED (production-readiness pass; it ran
# Report-Only first, audit Decision 4).
#
# Enforced because the evidence supports it: the built SPA has no inline
# script, no eval/new Function and no third-party script host; a browser
# sweep of platform, dashboard and academy pages (EN/AR, desktop/mobile) and
# probes of every dynamic source (certificate PDF preview, builder srcdoc
# preview, hls.js worker, YouTube, direct-to-storage uploads) raised zero
# violations under this exact policy; production reported none. Browsers
# still report every violation to `/api/v1/security/csp-reports` (the
# backend normalises it — no URL query survives — logs it and counts it in
# `atlas_csp_violations_total{disposition="enforce"}`), so anything missed
# is visible at once. See docs/CSP_AND_TOKEN_STORAGE.md in the backend repo.
#
# `script-src 'self'` is the directive that matters: an injected script
# cannot run, so it cannot act as the signed-in user (the refresh token is
# an HttpOnly cookie and the access token lives only in page memory).
#
# What each source is for:
#   script-src 'self'            Vite's hashed bundles only; no inline script,
#                                no eval (JSON-LD blocks are data, not script)
#   style-src 'unsafe-inline'    Radix/sonner/recharts inject <style> and
#                                style attributes at runtime
#   font-src 'self' data:        fonts are self-hosted (src/styles/fonts.css);
#                                no third-party font origin
#   img-src/media-src https:     academy logos, course media and video
#                                segments come from each academy's own
#                                storage/CDN host, which is configuration
#   connect-src https:           direct-to-storage uploads and HLS segments,
#                                same reason
#   frame-src                    YouTube lessons (nocookie first), the website
#                                builder's same-origin preview, and `blob:` for
#                                the certificate template's PDF preview (an
#                                object URL of the server-rendered PDF)
#   worker-src blob:             hls.js
#   object-src 'none'            no plugins (Chromium's PDF viewer in a blob
#                                frame is unaffected — verified)
(csp) {
	header Reporting-Endpoints `csp-endpoint="/api/v1/security/csp-reports"`
	header Content-Security-Policy `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/v1/security/csp-reports; report-to csp-endpoint`
}

# Theme 1 plan §E.4 — theme photographs. Every file lives in a versioned
# folder (`/theme-assets/<theme>/v<n>/…`) that is never changed once
# released (a changed image ships as a new version), so browsers and
# Cloudflare may keep them for a year without revalidating. Same origin,
# so the CSP needs nothing new. A missing file is a real 404 — never the
# SPA's index.html served as an "image".
(theme_assets) {
	handle /theme-assets/* {
		import security_headers
		root * /srv
		# Only a file that exists is immutable; a 404 must stay uncached.
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# Browser caching for the app's own static files (2 Oct 2026). Before this,
# nothing under /assets/ or the HTML shell carried a Cache-Control header,
# so every visit revalidated (or heuristically cached) everything.
#   * /assets/* — Vite's build output; every file name carries a content
#     hash, so a changed file is a new URL. Only a file that exists is
#     marked immutable; a 404 stays uncached.
#   * Everything else this block serves from disk is the SPA shell
#     (index.html via try_files, also in place of a missing /assets/ file)
#     or a root file such as robots.txt: always revalidated, so a deploy is
#     picked up on the next request. `?` sets it only when the response has
#     none (the server renderer sets its own).
# API responses are routed elsewhere and never pass through here; nothing
# per-user or per-tenant is ever marked cacheable.
(static_cache) {
	@hashed_asset {
		path /assets/*
		file
	}
	header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
	# Everything else, including the shell served in place of a MISSING
	# /assets/ file (which must never be cached as if it were the chunk).
	@app_shell {
		not path /theme-assets/*
		not {
			path /assets/*
			file
		}
	}
	header @app_shell ?Cache-Control "no-cache"
}

# P63g — HSTS is split by ownership. Atlas owns the whole platform tree,
# so `includeSubDomains` is right there. A customer's custom domain is
# NOT Atlas's to make policy for: asserting `includeSubDomains` on
# `customer.com` would force-upgrade `mail.customer.com` and every other
# host under it for a year. The backend applies the same split on `/api/*`.
(hsts_platform) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
(hsts_custom_domain) {
	header Strict-Transport-Security "max-age=31536000"
}

# Phase 8 — server-rendered public Academy pages
# (Reports/SSR_ARCHITECTURE_ANALYSIS.md). A page request for an Academy host
# that matches no static file goes to the renderer (`ssr`, internal network
# only). The renderer answers with the rendered page, or with
# `X-Atlas-SSR: pass` for anything it does not render (sign-in, learner
# pages, unknown hosts, files) — Caddy then serves `/srv/index.html`, the
# exact single-page app it served before. A renderer 5xx, a timeout or a
# stopped container is answered the same way (`ssr_unavailable` below), so
# the website never depends on the renderer being up.
#
# Off unless the container's ATLAS_SSR is `on` (compose passes it from
# /opt/atlas/.env; the default is off): with it off, every request takes
# exactly the route it took before server rendering existed.
#
# The renderer receives the visitor's IP (the API's per-visitor rate
# limits) and the request as sent; it forwards no cookie or credential to
# the API and never renders a signed-in view. `/assets/*` reaches it only
# when this image lacks the file (a rollout where the renderer is a build
# ahead); it serves its own build's hashed chunks, else a real 404.
(ssr_proxy) {
	vars atlas_ssr 1
	reverse_proxy ssr:3100 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 1s
			response_header_timeout 3s
		}
		@pass header X-Atlas-SSR pass
		handle_response @pass {
			rewrite * /index.html
			file_server
		}
		@failed status 5xx
		handle_response @failed {
			rewrite * /index.html
			file_server
		}
	}
}

# The renderer could not be reached or timed out: the single-page app,
# with the headers the document always carries (`{args[0]}` is the site's
# HSTS snippet). Only for requests that went to the renderer — an API 502
# stays a 502, and a missing chunk is never answered with HTML.
(ssr_unavailable) {
	@ssr_unavailable {
		vars atlas_ssr 1
		not path /assets/*
		expression `{err.status_code} in [502, 503, 504]`
	}
	handle @ssr_unavailable {
		import security_headers
		import csp
		import {args[0]}
		root * /srv
		rewrite * /index.html
		file_server {
			status 200
		}
	}
}

# Global options.
#
# fallback_sni (P63d): Cloudflare for SaaS connects to this origin for a
# customer's custom hostname with the CUSTOM hostname as the TLS SNI (the
# Host header too). This origin holds no certificate for a customer's
# name — and Caddy's catch-all block below cannot mint one, so before this
# option Caddy aborted the handshake ("no certificate available", TLS
# alert 80) and Cloudflare answered every visitor with 525 "SSL handshake
# failed". Verified in production against rawc.ae on 18 Sep 2026 and
# reproduced locally: with fallback_sni, an SNI that matches no loaded
# certificate is served the platform certificate instead, the handshake
# completes, and the request reaches the catch-all block where the Host
# header selects the academy. Cloudflare's origin SSL mode "Full" accepts a
# trusted certificate issued for a different name; "Full (strict)" would
# not (the Platform Owner readiness page reports the mode).
{
	fallback_sni atlass.dpdns.org

	# P63g — Cloudflare's published edge ranges are the only proxies whose
	# forwarded headers are believed. With this, `{client_ip}` is the real
	# visitor (Cloudflare's CF-Connecting-IP / X-Forwarded-For are honoured
	# only from these ranges) and a request that reaches the origin directly
	# is attributed to its own socket peer. The backend keys every rate
	# limiter on the `X-Real-IP` we forward below, so without this every
	# visitor behind one Cloudflare datacentre shared one bucket.
	# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (18 Sep 2026).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Main platform + every academy subdomain: one wildcard certificate covers
# both, since both are served identically by this same container — the
# frontend build already branches "atlas-app" vs "academy-website" mode at
# the JS level based on hostname (resolvePublicWebsiteContext). The
# DNS-01 issuer is scoped to this site block specifically (not a global
# default) so it doesn't collide with the catch-all block's own `tls
# internal` policy below. CLOUDFLARE_API_TOKEN is provided at container
# start via env_file, never baked into the image.
atlass.dpdns.org, *.atlass.dpdns.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			# ATO review F14 — the host the request actually reached, never a
			# client-supplied X-Forwarded-Host passed through a trusted proxy.
			header_up X-Forwarded-Host {host}
		}
	}

	import theme_assets

	handle {
		import security_headers
		import csp
		import hsts_platform
		root * /srv
		import static_cache
		# Academy subdomains only: the platform itself (apex, www) is the
		# dashboard and is never server-rendered.
		@academy_page {
			expression {env.ATLAS_SSR} == "on"
			not host atlass.dpdns.org www.atlass.dpdns.org
			method GET HEAD
			not file
		}
		handle @academy_page {
			import ssr_proxy
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	handle_errors {
		import ssr_unavailable hsts_platform
	}
}

# P63g — custom hostnames arriving over plain HTTP (a customer's own
# proxy in a non-TLS origin mode, or a stray http:// link) are redirected
# to HTTPS instead of hitting an unhandled port. The platform names get
# this automatically from Caddy; the catch-all must declare it.
:80 {
	redir https://{host}{uri} permanent
}

# Catch-all fallback for connected custom domains (e.g. an academy's own
# domain via the existing Cloudflare Custom Hostnames flow). Cloudflare's
# edge terminates and manages TLS for the custom hostname itself once
# verified; this origin just needs to answer TLS on any other SNI and
# serve the same app — same static files, same API routing, Host header
# alone (already handled entirely by the frontend's own hostname-resolution
# logic) decides which academy is served. The certificate presented for
# that "any other SNI" comes from the global fallback_sni above — `tls
# internal` here only names the issuer for this block's (empty) hostname
# set and does NOT issue certificates for arbitrary SNI.
:443 {
	tls internal

	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {client_ip}
			# ATO review F14 — the host the request actually reached, never a
			# client-supplied X-Forwarded-Host passed through a trusted proxy.
			header_up X-Forwarded-Host {host}
		}
	}

	import theme_assets

	handle {
		# Previously this block set NO security headers at all, so an
		# academy serving its own connected domain got none of them on its
		# document while the same content on `*.atlass.dpdns.org` got all
		# four. Same app, same files, weaker headers — purely because of
		# which hostname the visitor arrived on.
		import security_headers
		import csp
		import hsts_custom_domain
		root * /srv
		import static_cache
		# Every host here is an Academy's connected domain.
		@academy_page {
			expression {env.ATLAS_SSR} == "on"
			method GET HEAD
			not file
		}
		handle @academy_page {
			import ssr_proxy
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	handle_errors {
		import ssr_unavailable hsts_custom_domain
	}
}
